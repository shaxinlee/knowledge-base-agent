# App
APP_NAME=Knowledge Base Agent Assistant
SERVICE_NAME=backend-api
VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:63166","http://127.0.0.1:63166","http://localhost:50639","http://127.0.0.1:50639"]

# PostgreSQL
POSTGRES_USER=kb_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kb_agent
DATABASE_URL=postgresql+psycopg://kb_agent:change-me@postgres:5432/kb_agent

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks

# OpenSearch BM25 keyword retrieval
BM25_ENABLED=true
BM25_PROVIDER=opensearch
BM25_BASE_URL=http://opensearch:9200
BM25_INDEX_NAME=chunks_bm25
BM25_TOP_K=50
BM25_INDEX_ANALYZER=ik_max_word
BM25_SEARCH_ANALYZER=ik_smart

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_RAW_FILES=raw-files
MINIO_BUCKET_PARSED_RESULTS=parsed-results
MINIO_BUCKET_NORMALIZED_DOCS=normalized-docs
MINIO_BUCKET_ASSETS=assets
MINIO_BUCKET_EXPORTS=exports

# Auth
JWT_SECRET_KEY=dev-only-change-me-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPassword123
DEFAULT_ADMIN_DISPLAY_NAME=Administrator
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_BATCH_UPLOAD_COUNT=50

# RAG trace
ENABLE_PROMPT_TRACE=false
CHAT_HISTORY_RETENTION_DAYS=0

# LLM provider
LLM_PROVIDER=
LLM_API_BASE_URL=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
EVIDENCE_MIN_RERANKER_SCORE=

# Image chunk descriptions
IMAGE_DESCRIPTION_ENABLED=true
IMAGE_DESCRIPTION_API_BASE_URL=
IMAGE_DESCRIPTION_API_KEY=
IMAGE_DESCRIPTION_MODEL=qwen3.6-flash
IMAGE_DESCRIPTION_TIMEOUT_SECONDS=120

# MinerU API
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=true
MINERU_REQUEST_TIMEOUT_SECONDS=30

# Model services
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_SERVICE_URL=http://embedding-service:8200
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16
QWEN_EMBEDDING_MODEL=qwen-vl-embedding
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com
RERANKER_API_BASE_URL=
RERANKER_API_KEY=
RERANKER_SERVICE_URL=http://reranker-service:8300
RERANKER_MODEL=bge-reranker

# Development-only first-version Demo fixture.
# When true, backend uses local deterministic demo embedding/reranker clients and template LLM.
DEMO_FIXTURE_ENABLED=false

# Optional test fixture archive. Do not commit the archive itself.
TEST_FIXTURE_ARCHIVE=
